dispatch minecraft:storage[arcane_core.api:io] to struct IOStorage {
	in: IOStorageIn,
	out: IOStorageOut,
}

type VersionArray = [int @ 0..] @ 3

struct IOStorageIn {
	core: struct {
		register_project: InRegisterProject,
	},
	"any": any,
}

struct IOStorageOut {
	return: any
}

struct InRegisterProject {
	namespace: string @ 1..,
	name: string @ 1..,
	version: VersionArray,
	core_version: VersionArray,
	resourcepack?: struct InRegisterProjectResourcePack {
		required: boolean
	},
}

/// Custom item data to be exposed through data storage.
struct CustomItemData {
	[#[dispatcher_key="arcane_core.api:module.item.data"] string]?: arcane_core.api:module.item.data[[%key]],
}

struct ItemModuleStorage {
	hand: struct {
		/// Custom item data of the item in the currently processed hand.
		current?: CustomItemData,
		/// Custom item data of the item in the other hand that's not currently being processed.
		other?: CustomItemData,
	}
}

dispatch arcane_core.api:module.item.data[%unknown] to any

dispatch minecraft:storage[arcane_core.api:module.item] to ItemModuleStorage

dispatch mcdoc:custom_data["arcane_core.api"] to struct ItemData {
	update?: struct {
		item_modifier: #[id="item_modifier"] string,
	},
	tick?: struct {
		function: #[id="function"] string,
	},

	/// Custom item data to be exposed through data storage.
	data?: CustomItemData,

	// Top level extensions allowed for framework's internal usage only.
	// These keys are not stable and not part of the public API surface.
	[#[dispatcher_key="arcane_core.internal:module.item"] string]?: arcane_core.internal:module.item[[%key]],
}
