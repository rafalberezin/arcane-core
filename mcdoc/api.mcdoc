dispatch minecraft:storage[arcane_core.api:io] to struct IOStorage {
	in: IOStorageIn,
	out: IOStorageOut,
}

type VersionArray = [int @ 0..] @ 3

struct IOStorageIn {
	core: struct {
		register_project: InRegisterProject,
	},
	"any": any,
}

struct IOStorageOut {
	return: any
}

struct InRegisterProject {
	namespace: string @ 1..,
	name: string @ 1..,
	version: VersionArray,
	core_version: VersionArray,
	resourcepack?: struct InRegisterProjectResourcePack {
		required: boolean
	},
}
